#!/bin/bash

set -euo pipefail

check_command() {
    if ! command -v "$1" &>/dev/null; then
        echo "$1 not found. Install: $2" >&2
        exit 1
    fi
}

check_command jsonlint "https://pypi.org/project/demjson3/"
jsonlint --strict directory.json

check_command diff "https://www.gnu.org/software/diffutils/"
check_command jq "https://jqlang.github.io/jq/download/"
diff --color=always -u3 directory.json <(cat directory.json | jq -S) -L directory.json -L directory.json
